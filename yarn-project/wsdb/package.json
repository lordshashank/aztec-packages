{
  "name": "@aztec/wsdb",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dest/index.d.ts",
      "default": "./dest/index.js"
    }
  },
  "files": [
    "dest/",
    "build/",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dest .tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "prepare_arch_packages": "./scripts/prepare_arch_packages.sh",
    "generate": "node --experimental-strip-types --experimental-transform-types --no-warnings \"../../ipc-codegen/src/generate.ts\" --schema \"../../barretenberg/cpp/src/barretenberg/wsdb/wsdb_schema.json\" --lang ts --client --out \"src/generated\" --prefix \"Wsdb\" --strip-method-prefix --package . --package-name \"@aztec/wsdb\" --binary-name \"aztec-wsdb\" --package-transports \"uds,shm\" --ipc-runtime-dependency \"portal:../../ipc-runtime/ts\""
  },
  "dependencies": {
    "@aztec/ipc-runtime": "portal:../../ipc-runtime/ts",
    "msgpackr": "^1.11.2",
    "tslib": "^2.4.0"
  },
  "optionalDependencies": {
    "@aztec/wsdb-darwin-arm64": "0.1.0",
    "@aztec/wsdb-darwin-x64": "0.1.0",
    "@aztec/wsdb-linux-arm64": "0.1.0",
    "@aztec/wsdb-linux-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.3.3"
  }
}
